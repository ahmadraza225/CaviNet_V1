# CaviNet configuration. `make up` creates .env from this file on first run and replaces
# every __GENERATE...__ value with a random one. .env is git-ignored: never commit it.

# Database credentials (used only inside Docker; the database port is not exposed).
POSTGRES_USER=cavinet
POSTGRES_PASSWORD=__GENERATE_HEX__
POSTGRES_DB=cavinet

# Signs sign-in tokens. Keep it secret; changing it signs everyone out.
SECRET_KEY=__GENERATE_SECRET__

# First administrator, created on first start (FR-01.7). They must change this password
# at first sign-in.
ADMIN_EMAIL=admin@cavinet.local
ADMIN_PASSWORD=__GENERATE_PASSWORD__

# Demo doctor account created by `make seed`.
DEMO_DOCTOR_EMAIL=doctor@cavinet.local
DEMO_DOCTOR_PASSWORD=__GENERATE_PASSWORD__

# Port for the web application: http://localhost:8080
CAVINET_HTTP_PORT=8080

# Set to true only when CaviNet is served over HTTPS (browsers then require Secure cookies).
COOKIE_SECURE=false

ENVIRONMENT=development

# AI model (section 11.6). `make up` and `make fetch-model` download MODEL_URL (a GitHub
# Release asset, about 330 MB) into models/ and replace a demo model. Set MODEL_URL=none to
# use the demo model instead (synthetic data, every result is marked "DEMO MODEL: NOT FOR
# CLINICAL USE"); it is also built if the download fails and no model is installed.
MODEL_URL=https://github.com/ahmadraza225/CaviNet_V1/releases/download/model-v1/cavinet_model.pth
# SHA-256 of the release asset: the download is refused if it does not match, and a different
# installed model is replaced by this one.
MODEL_SHA256=975e61e437836b3cafd2b66739c39e186805c736f9b4fc155d47f3ace643949a
