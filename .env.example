# CaviNet configuration. `make up` copies this file to .env on first run.
# .env is git-ignored: never commit it.

# Database credentials (used only inside Docker; the database port is not exposed).
# Use letters and digits only in the password.
POSTGRES_USER=cavinet
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cavinet

# Port for the web application: http://localhost:8080
CAVINET_HTTP_PORT=8080

ENVIRONMENT=development
